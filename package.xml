<?xml version="1.0"?>
<package format="3">
	<name>bno085_driver</name>
	<version>0.1.0</version>
	<description>UART-SHTP driver node for the BNO085 IMU, publishing sensor_msgs/Imu with on-demand magnetometer calibration.</description>
	<maintainer email="vid.rijavec@fri.uni-lj.si">MoffKalast</maintainer>
	<license>MIT</license>

	<buildtool_depend>ament_cmake</buildtool_depend>

	<exec_depend>rclpy</exec_depend>
	<exec_depend>sensor_msgs</exec_depend>
	<exec_depend>std_msgs</exec_depend>
	<exec_depend>diagnostic_msgs</exec_depend>
	<exec_depend>python3-serial</exec_depend>

	<export>
		<build_type>ament_cmake</build_type>
	</export>
</package>
